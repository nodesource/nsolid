prefix agents

# To mark a test as flaky, list the test name in the appropriate section
# below, without its extension, followed by ": PASS,FLAKY". Example:
# sample-test                        : PASS,FLAKY

[true] # This section applies to all platforms
# https://github.com/nodesource/nsolid/issues/688: its child process can crash
# as it exits.
test-otlp-grpc-tls: PASS,FLAKY
# https://github.com/nodesource/nsolid/issues/706: a blocked-loop event or the
# startup tracing race can fail it.
test-zmq-tracing: PASS,FLAKY
